  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^8.2.2",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}